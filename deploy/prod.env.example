# /etc/amigo/prod.env — environment for amigo@N (SYNC_V2 §13.10.4).
# KEY NAMES ONLY. Never commit real values.
#
# Build it on the box from what prod runs with today:
#   1. /home/ubuntu/amigo-backend/.env
#   2. PLUS whatever the tmux bun process has in its environment that is not
#      in .env:  sudo cat /proc/<bun pid>/environ | tr '\0' '\n'
#      (ignore shell noise: PATH, HOME, TERM, TMUX*, SHELL, PWD, …)
#   3. MINUS SERVER_PORT and SOCKET_PORT — the unit sets them per slot
#      (5101/5201 or 5102/5202). Left in, they could not be overridden
#      reliably and both slots would try to bind the same ports.
# Then:  sudo install -m 0640 -o root -g ubuntu prod.env /etc/amigo/prod.env
#
# Syntax: systemd EnvironmentFile — KEY=value per line, no `export`.
# Wrap values containing spaces or # in double quotes. Do not use $VAR
# references; systemd does not expand them here.
#
# Set by the unit, NOT here: INSTANCE_ID, SERVER_PORT, SOCKET_PORT,
# PG_POOL_MAX, REDIS_NS, CLUSTER_MAX.
# Not needed: GIT_REV (each release dir has a REVISION file).
# The Firebase service account stays where it is in the code (decision);
# it does not go in this file.

# --- core -------------------------------------------------------------------
# Direct RDS URL (no pooler) — V17.
DB_URL=
# Prod Redis Cloud database. Must NOT be the same database dev uses (V14).
REDIS_URL=
# Leave unset (or "prod") on prod. "dev" switches the Redis namespace to d:
# and the ledger runner's safety prompt.
#APP_ENV=

# --- auth / sessions ----------------------------------------------------------
# Auth-adjacent: copy these EXACTLY as prod has them today — same presence,
# same value. FRONTEND_URL, COOKIE_DOMAIN and NODE_ENV decide the cookie
# configuration (auth.routes.ts), the TTLs decide token lifetimes.
ACCESS_KEY=
PIN_PEPPER=
# Optional — uncomment only if today's .env / environ has them.
#ACCESS_TOKEN_TTL=
#REFRESH_TOKEN_TTL=
#DEVICE_TOKEN_TTL=
#COOKIE_DOMAIN=
#NODE_ENV=

# --- OTP providers --------------------------------------------------------------
RENFLAIR_URL=
RENFLAIR_API_KEY=
RENFLAIR_SMS_URL=
RENFLAIR_SMS_API_KEY=
# Must stay unset / false on prod.
#OTP_DEV_MODE=
#ALLOW_DEV_SECRET=

# --- media (S3) -----------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# --- calls (LiveKit) ------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- web / admin ----------------------------------------------------------------
FRONTEND_URL=

# --- legacy: present in today's .env, not read by the current code -----------
# Copying them is harmless; uncomment if you want an exact copy of .env.
#STREAM_API_KEY=
#STREAM_API_SECRET=
#STREAM_WEBHOOK_SECRET=
#GOOGLE_APPLICATION_CREDENTIALS=
#JAIPUR_SMS_API_KEY=
#SMS_URL=

# --- tuning (optional; defaults shown) ------------------------------------------
# Statement lock wait in ms before failing instead of pinning a pool
# connection. 0 disables. Not sent to pooler URLs.
#PG_LOCK_TIMEOUT_MS=5000
# Swap marker read by the boot guard (deploy.sh touches it).
#AMIGO_SWAP_FILE=/run/amigo/swap
# Opt-in debug lines (src/utils/debug-log.ts), comma-separated tags or "*":
# PENDING = pending-queue store / read / remove per user, FANOUT = recipient
# ids per [FANOUT] line. Unset on prod except while chasing a field report.
#AMIGO_DEBUG=
# Cross-worker routing (RC-2, deploy/CLUSTER-DEV.md). Leave unset on prod
# until RC-4: unset + CLUSTER_MAX=1 = "local" = today's behaviour. "shadow"
# writes the presence registry and counts [CLUSTER] presence_mismatch
# without depending on it.
#CLUSTER_ROUTING=
#CLUSTER_PRESENCE_DEADLINE_MS=500
# Close a user's previous socket with 4009 when a new one registers
# (§13.6.5). 0 = leave it open (pre-RC-2 behaviour).
#WS_CLOSE_REPLACED=1
# FCM ack fallback deadline in ms (R1b; active only while app_settings
# sync_v2_ack_fallback is on): a message:new a foreground socket has not
# acked "delivered" by then gets a normal-priority FCM push. Clamped 3000..120000.
#FCM_ACK_FALLBACK_MS=10000
