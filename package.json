{
  "name": "amigo-backend",
  "version": "3.0.0",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun run --watch src/server.ts",
    "db:genpush": "drizzle-kit generate && drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "migrate": "bun run scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "version:set": "bun run scripts/set-app-version.ts",
    "version:notify": "bun run scripts/notify-app-update.ts",
    "flush:migrate": "bun run scripts/flush-before-migration.ts",
    "backfill:lastmsg": "bun run scripts/backfill-last-msg.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.891.0",
    "@aws-sdk/s3-request-presigner": "^3.891.0",
    "@elysiajs/cors": "^1.4.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "elysia": "latest",
    "firebase-admin": "^13.5.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.17",
    "livekit-server-sdk": "^2.17.0",
    "nanoid": "^5.1.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.31.4"
  },
  "module": "src/index.js"
}
